# ═══════════════════════════════════════════════════════════════════════════════
# DocMind — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. .env.example is safe to commit.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development              # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true                   # Set false in production
SECRET_KEY=change-me-to-a-random-64-char-string   # Used for API key hashing

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Primary: groq  (free, fast, cloud — recommended for low-end PCs)
# Fallback: ollama (local, needs Ollama installed)
# Optional: openai (paid)
LLM_PROVIDER=groq

# Groq (Primary — get free key at console.groq.com)
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=llama-3.1-8b-instant   # Free tier, 300+ tokens/sec

# Ollama (Optional fallback — only if you have Ollama installed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI (Optional — paid)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# ─── Embedding Model ──────────────────────────────────────────────────────────
# Recommended for LOW-END PCs (118M params, ~450 MB RAM, multilingual):
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Higher quality (570M params, ~1.5 GB RAM) — use if you have 8+ GB free RAM:
# EMBEDDING_MODEL=BAAI/bge-m3

EMBEDDING_DEVICE=cpu             # cpu | cuda | mps
EMBEDDING_BATCH_SIZE=16          # Lower = less RAM. Increase if you have headroom.
EMBEDDING_DIM=384                # 384 for MiniLM; 1024 for BGE-M3

# ─── Reranker ─────────────────────────────────────────────────────────────────
# Disabled by default on low-end PCs. Set true if you have ~600 MB free RAM.
ENABLE_RERANKER=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K=5                 # Number of chunks to pass to LLM after reranking
RERANKER_CANDIDATE_K=30          # Number of candidates to rerank from retrieval

# ─── Retrieval ────────────────────────────────────────────────────────────────
VECTOR_TOP_K=20                  # Chunks fetched from Qdrant
BM25_TOP_K=20                    # Chunks fetched from BM25 index
RRF_K=60                         # RRF smoothing constant (60 is standard)

# ─── Confidence & "I Don't Know" ──────────────────────────────────────────────
# How this works:
#   After retrieval and (optional) reranking, the top chunk gets a relevance score.
#   Reranker score: 0.0 (irrelevant) → 1.0 (perfect match)
#   Vector similarity: 0.0 (no match) → 1.0 (identical)
#
#   LOW_CONFIDENCE_THRESHOLD  — below this, we warn but still attempt an answer
#   NO_ANSWER_THRESHOLD       — below this, we skip the LLM entirely and say "I don't know"
#
#   Example: score=0.12 → no answer returned
#            score=0.28 → answer returned with a "low confidence" warning badge
#            score=0.55 → normal confident answer
LOW_CONFIDENCE_THRESHOLD=0.35    # Show warning badge in response
NO_ANSWER_THRESHOLD=0.15         # Skip LLM, return "I don't know"

# ─── Vector Database (Qdrant) ─────────────────────────────────────────────────
# Local file mode (no Docker needed for dev):
QDRANT_MODE=local                # local | server
QDRANT_LOCAL_PATH=./data/qdrant_storage
# Server mode (uncomment if running Qdrant via Docker):
# QDRANT_MODE=server
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=                # Leave blank for local Docker
QDRANT_COLLECTION=docmind_chunks

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600           # Semantic cache TTL (1 hour)
CACHE_SIMILARITY_THRESHOLD=0.97  # Cosine similarity for cache hit

# ─── Celery (Async Ingestion) ─────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=512                   # Child chunk size in tokens
CHUNK_OVERLAP=50                 # Overlap between consecutive chunks
PARENT_CHUNK_SIZE=1536           # Parent chunk size (fed to LLM for context)

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=60           # Requests allowed per window
RATE_LIMIT_WINDOW_SECONDS=60     # Window size in seconds

# ─── Feature Flags ────────────────────────────────────────────────────────────
ENABLE_VOICE=false               # Set true to enable Whisper ASR endpoint
ENABLE_METRICS=true              # Set false to disable /metrics endpoint

# ─── File Upload ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50            # Maximum file size in megabytes
ALLOWED_EXTENSIONS=pdf,docx,txt,md

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/docmind.sqlite
# Postgres (for production — change only this line):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/docmind
